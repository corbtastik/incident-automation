# incident-automation inputs.
#
# Copy to .env and fill in. .env is gitignored.
#
# Two ways to use it:
#   podman run --rm --env-file .env ...                 read by podman
#   podman run --rm -v "$PWD/.env:/config/.env:ro" ...  read by the container
#
# Explicit -e wins over the file. --env-file cannot carry multi-line values,
# so GCP_CREDENTIALS_JSON belongs on the command line or is read from output/.

# --- Required ---

# Bootstrap service account key, as JSON. Passed to the container as an
# argument, never mounted. Produced by `gcp bootstrap`; not needed to run it.
#   GCP_CREDENTIALS_JSON="$(cat output/gcp-bootstrap-key.json)"
GCP_CREDENTIALS_JSON=

# The project to operate in. Bring your own; setup does not create it.
GCP_PROJECT_ID=

# Base name for the media bucket, required by `apply` and `setup`. A random
# slug is appended to avoid collisions in the global bucket namespace, e.g.
# incident-app-7f3a2b. Max 56 characters, to leave room for the slug.
GCS_BUCKET_BASE_NAME=incident-app

# --- Optional, with defaults ---

#BOOTSTRAP_SA_NAME=incident-automation-bootstrap
#RUNTIME_SA_NAME_BASE=incident-app-storage
#GCS_LOCATION=us-central1
#SA_NAME_BASE=incident-app-storage
#GCP_INSTANCE_SLUG=              # set to pin or re-adopt an existing instance
#HOST_OUTPUT_DIR=./output        # host path, used when writing the emitted .env
#SKIP_API_ENABLE=false

# --- Atlas ---

# Org API key, created in the Atlas UI. There is no way to mint the first one,
# so this is always supplied by you.
#ATLAS_PUBLIC_KEY=
#ATLAS_PRIVATE_KEY=

# The project to operate in. Setup does not create it.
#ATLAS_PROJECT_ID=
#ATLAS_ORG_ID=
